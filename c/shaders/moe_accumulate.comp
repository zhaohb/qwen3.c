#version 450
// resid[d] += sum_c weights[c] * y[c*D + d] — folds the expert_group outputs back into
// the device residual stream so the next layer's route can wait on a GPU semaphore
// instead of a host fence + memcpy.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer Y { float y[]; };       // [count, D]
layout(std430, binding = 1) readonly  buffer W { float weights[]; }; // [count]
layout(std430, binding = 2) buffer R { float resid[]; };             // [D] read-write

layout(push_constant) uniform PC { int count, D; } p;

void main() {
    int d = int(gl_GlobalInvocationID.x);
    if (d >= p.D) return;
    float acc = 0.0;
    for (int c = 0; c < p.count; c++) acc += weights[c] * y[c * p.D + d];
    resid[d] += acc;
}
